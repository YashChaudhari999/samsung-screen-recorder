<?xml version="1.0" encoding="utf-8"?><manifest xmlns:android="http://schemas.android.com/apk/res/android"    package="com.sec.app.screenrecorder"    android:versionCode="80000000"    android:versionName="8.0.0-Android16-Aligned">    <uses-sdk        android:minSdkVersion="29"        android:targetSdkVersion="36" />    <!-- Audio & System Sound Recording Permissions -->    <uses-permission android:name="android.permission.RECORD_AUDIO" />    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />    <uses-permission android:name="com.samsung.android.permission.EXTRACT_INTERNAL_AUDIO" />    <!-- Storage & Gallery Visibility Permissions -->    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />    <!-- System & Service Permissions -->    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />        <!-- Samsung Specific Knox & One UI 8.0 Permissions -->    <uses-permission android:name="com.samsung.android.knox.permission.KNOX_SCREEN_RECORD" />    <uses-permission android:name="com.sec.enterprise.knox.permission.CUSTOM_SYSTEM" />    <application        android:name="com.sec.app.screenrecorder.ScreenApplication"        android:allowBackup="false"        android:icon="@drawable/icon"        android:label="@string/app_name"        android:supportsRtl="true"        android:theme="@style/Theme.OneUI8.Dark"        android:requestLegacyExternalStorage="true"        android:preserveLegacyExternalStorage="true">        <meta-data            android:name="com.samsung.android.sdk.knox.api_level"            android:value="39" />        <meta-data            android:name="com.samsung.android.oneui.version"            android:value="80000" />        <activity            android:name=".activity.LauncherActivity"            android:exported="true"            android:theme="@android:style/Theme.Translucent.NoTitleBar">            <intent-filter>                <action android:name="android.intent.action.MAIN" />                <category android:name="android.intent.category.LAUNCHER" />            </intent-filter>        </activity>        <service            android:name=".encoder.RecordingThreadService"            android:exported="false"            android:foregroundServiceType="mediaProjection" />        <!-- Provider to ensure Gallery indexing works correctly -->        <provider            android:name="androidx.core.content.FileProvider"            android:authorities="com.sec.app.screenrecorder.fileprovider"            android:exported="false"            android:grantUriPermissions="true">            <meta-data                android:name="android.support.FILE_PROVIDER_PATHS"                android:resource="@xml/file_paths" />        </provider>    </application></manifest>