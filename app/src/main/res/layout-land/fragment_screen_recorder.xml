<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <LinearLayout
        android:id="@+id/dialog_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_bottom_sheet">

        <!-- ───────────────────────────────────────── Dialog Header ── -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="2dp"
            android:text="Start recording with Screen recorder?"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.15" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="10dp"
            android:text="Screen recorder will have access to the info on your screen or played from your phone while recording."
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:textSize="11.5sp"
            android:lineSpacingExtra="1dp" />

        <!-- ───────────────────────────── Symmetrical 2-Column Options ── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:weightSum="2">

                <!-- ────────────── Left Column: Area to record ──── -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="6dp"
                        android:text="Area to record"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="92dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Full screen (SELECTED) -->
                        <LinearLayout
                            android:id="@+id/option_full_screen"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_area_option_selected">

                            <ImageView
                                android:id="@+id/iv_full_screen"
                                android:layout_width="48dp"
                                android:layout_height="27dp"
                                android:src="@drawable/sel_full_screen_land_icon"
                                android:contentDescription="Full screen icon"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/tv_full_screen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full screen"
                                android:textColor="@color/accent_blue"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="12sp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rb_full_screen"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:checked="true"
                                android:clickable="false"
                                android:focusable="false"
                                android:background="@null"
                                android:buttonTint="@null"
                                app:buttonTint="@null"
                                android:button="@drawable/sel_samsung_radio" />

                        </LinearLayout>

                        <!-- Partial screen (UNSELECTED) -->
                        <LinearLayout
                            android:id="@+id/option_partial_screen"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_area_option_unselected">

                            <ImageView
                                android:id="@+id/iv_partial_screen"
                                android:layout_width="48dp"
                                android:layout_height="27dp"
                                android:src="@drawable/sel_partial_screen_land_icon"
                                android:contentDescription="Partial screen icon"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/tv_partial_screen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Partial screen"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="12sp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rb_partial_screen"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:checked="false"
                                android:clickable="false"
                                android:focusable="false"
                                android:background="@null"
                                android:buttonTint="@null"
                                app:buttonTint="@null"
                                android:button="@drawable/sel_samsung_radio" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- ────────────── Right Column: Audio to record ────── -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingBottom="6dp"
                        android:text="Audio to record"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="92dp"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:background="@drawable/bg_area_option_unselected"
                        android:padding="6dp">

                        <!-- None (SELECTED) -->
                        <LinearLayout
                            android:id="@+id/option_audio_none"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <ImageView
                                android:id="@+id/iv_audio_none"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_oui_sound_mute"
                                android:contentDescription="No audio" />

                            <TextView
                                android:id="@+id/tv_audio_none"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="None"
                                android:textColor="@color/accent_blue"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="11.5sp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rb_audio_none"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:checked="true"
                                android:clickable="false"
                                android:focusable="false"
                                android:background="@null"
                                android:buttonTint="@null"
                                app:buttonTint="@null"
                                android:button="@drawable/sel_samsung_radio" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/divider_color" />

                        <!-- Media (UNSELECTED) -->
                        <LinearLayout
                            android:id="@+id/option_audio_media"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <ImageView
                                android:id="@+id/iv_audio_media"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_oui_sound"
                                android:contentDescription="Media audio" />

                            <TextView
                                android:id="@+id/tv_audio_media"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Media"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="11.5sp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rb_audio_media"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:checked="false"
                                android:clickable="false"
                                android:focusable="false"
                                android:background="@null"
                                android:buttonTint="@null"
                                app:buttonTint="@null"
                                android:button="@drawable/sel_samsung_radio" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/divider_color" />

                        <!-- Media and mic (UNSELECTED) -->
                        <LinearLayout
                            android:id="@+id/option_audio_media_mic"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:orientation="horizontal"
                                android:gravity="center">
                                <ImageView
                                    android:id="@+id/iv_audio_media_mic_1"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_oui_sound"
                                    android:contentDescription="Media audio" />
                                <ImageView
                                    android:id="@+id/iv_audio_media_mic_2"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_oui_voice"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="Mic audio" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_audio_media_mic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="Media &amp; mic"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <RadioButton
                                android:id="@+id/rb_audio_media_mic"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:checked="false"
                                android:clickable="false"
                                android:focusable="false"
                                android:background="@null"
                                android:buttonTint="@null"
                                app:buttonTint="@null"
                                android:button="@drawable/sel_samsung_radio" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ──────────────── Divider above bottom action buttons ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <!-- ─────────────── Dedicated bottom action buttons ─────────── -->
        <LinearLayout
            android:id="@+id/bottom_actions_container"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Cancel -->
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:background="?attr/selectableItemBackground"
                style="@style/Widget.AppCompat.Button.Borderless" />

            <!-- Thin vertical divider between buttons -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider_color" />

            <!-- Start recording -->
            <Button
                android:id="@+id/btn_start_recording"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Start recording"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:background="?attr/selectableItemBackground"
                style="@style/Widget.AppCompat.Button.Borderless" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
